{
  "buildCommand": "npm run build",
  "framework": "create-react-app",
  "installCommand": "npm install",
  "outputDirectory": "build",
  "env": {
    "GIT_SUBMODULES": "false"
  },
  "regions": ["iad1"],
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/:path*", "destination": "/index.html" }
  ]
}
