{
  "buildCommand": "npm run build",
  "framework": "create-react-app",
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/:path*", "destination": "/index.html" }
  ],
  "functions": {
    "api/stock.py": {
      "memory": 1024,
      "maxDuration": 30
    },
    "api/ask.py": {
      "memory": 1024,
      "maxDuration": 30
    }
  },
  "env": {
    "GEMINI_API_KEY": "@gemini_api_key",
    "JWT_SECRET_KEY": "@jwt_secret_key"
  }
}
